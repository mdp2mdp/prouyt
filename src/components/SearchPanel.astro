---
import Icon from './Icon.astro';
import { url, site } from '../lib/site.js';
---
<div class="search" id="site-search" role="dialog" aria-modal="true" aria-label="Поиск по каталогу" hidden data-search data-index={url('search-index.json')} data-phone={site.contacts.phoneHref} data-phone-text={site.contacts.phone}>
  <div class="search__backdrop" data-search-close></div>
  <div class="search__panel">
    <form class="search__form" role="search" data-search-form>
      <Icon name="search" size={22} class="search__icon" />
      <input class="search__input" type="search" name="q" placeholder="Название модели, например «Трио»" aria-label="Поиск по каталогу" autocomplete="off" enterkeyhint="search" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" data-search-input />
      <button class="search__close" type="button" aria-label="Закрыть поиск" data-search-close><Icon name="close" size={22} /></button>
    </form>
    <div class="search__body">
      <ul class="search__results" id="search-results" role="listbox" aria-label="Результаты поиска" data-search-results></ul>
      <div class="search__hint" data-search-hint></div>
    </div>
    <p class="visually-hidden" role="status" aria-live="polite" data-search-status></p>
  </div>
</div>

<style is:global>
  .search { position: fixed; inset: 0; z-index: calc(var(--z-header) + 5); }
  .search[hidden] { display: none; }
  .search__backdrop { position: absolute; inset: 0; background: rgb(16 30 21 / 0.55); backdrop-filter: blur(3px); }
  .search__panel { position: relative; margin: var(--header-h) auto 0; width: 100%; max-width: 44rem; max-height: calc(100svh - var(--header-h)); display: flex; flex-direction: column; background: var(--color-surface); border-radius: 0 0 var(--radius-lg) var(--radius-lg); box-shadow: var(--shadow-lg); overflow: hidden; }
  .search__form { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-3) var(--space-3) var(--space-5); border-bottom: var(--border-thin) solid var(--color-border); }
  .search__form :global(.search__icon) { color: var(--color-text-muted); }
  .search__input { flex: 1; min-width: 0; min-height: 2.75rem; border: 0; background: transparent; color: var(--color-text-strong); font: inherit; font-size: var(--text-lg); outline: none; }
  .search__input::placeholder { color: var(--color-text-muted); }
  .search__input::-webkit-search-cancel-button { display: none; }
  .search__close { display: inline-grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border: 0; border-radius: var(--radius-round); background: transparent; color: var(--color-text-strong); cursor: pointer; transition: background-color var(--duration-fast); }
  .search__close:hover { background: var(--color-bg-alt); }
  .search__body { overflow-y: auto; overscroll-behavior: contain; padding: var(--space-2); }
  .search__results { display: grid; gap: var(--space-1); }
  .search__results[hidden] { display: none; }
  .search__hint { padding: var(--space-4) var(--space-3); color: var(--color-text-muted); font-size: var(--text-sm); }
  .search__hint a { color: var(--color-text-strong); }
  .search__hint[hidden] { display: none; }
  .search__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .search__chips a { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 var(--space-4); border: var(--border-thin) solid var(--color-border-strong); border-radius: var(--radius-round); color: var(--color-text-strong); text-decoration: none; transition: border-color var(--duration-fast), background-color var(--duration-fast); }
  .search__chips a:hover { border-color: var(--color-brand); background: var(--color-bg-alt); }
  .search__item { display: grid; grid-template-columns: 5rem 1fr auto; align-items: center; gap: var(--space-4); padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); color: var(--color-text-strong); text-decoration: none; }
  .search__item:hover, .search__item.is-active { background: var(--color-bg-alt); }
  .search__thumb { width: 5rem; aspect-ratio: 3 / 2; border-radius: var(--radius-sm); background: var(--photo-bg); overflow: hidden; }
  .search__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .search__name { font-family: var(--font-serif); font-size: var(--text-lg); text-transform: uppercase; letter-spacing: 0.02em; line-height: var(--leading-snug); }
  .search__meta { margin-top: 2px; font-size: var(--text-xs); color: var(--color-text-muted); }
  .search__price { font-weight: 600; font-size: var(--text-sm); white-space: nowrap; }
  .search__item mark { background: var(--color-accent); color: inherit; border-radius: 3px; padding: 0 1px; }
  @media (max-width: 639px) {
    .search__item { grid-template-columns: 4rem 1fr; }
    .search__price { grid-column: 2; }
    .search__thumb { width: 4rem; }
  }
  @media (min-width: 900px) {
    .search__panel { margin-top: var(--header-h-lg); max-height: calc(100svh - var(--header-h-lg) - var(--space-6)); border-radius: 0 0 var(--radius-lg) var(--radius-lg); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .search:not([hidden]) .search__panel { animation: search-in var(--duration) var(--ease); }
    .search:not([hidden]) .search__backdrop { animation: search-fade var(--duration) var(--ease); }
    @keyframes search-in { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: none; } }
    @keyframes search-fade { from { opacity: 0; } to { opacity: 1; } }
  }
</style>
