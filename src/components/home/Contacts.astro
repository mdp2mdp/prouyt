---
import Icon from '../Icon.astro';
import { site } from '../../lib/site.js';
const c = site.contacts;
---
<div class="contacts">
  <div class="contacts__lead" data-reveal>
    <h2>{site.home.contactsCall}</h2>
    <a class="contacts__phone" href={c.phoneHref}>{c.phone}</a>
    <p class="contacts__hint">Подскажем по тканям, цветам и срокам</p>
    <a class="btn btn--primary btn--lg" href={c.phoneHref}>
      <Icon name="phone" size={20} /> Позвонить
    </a>
  </div>
  <ul class="contacts__list" data-reveal style="--reveal-i:1">
    <li>
      <span class="contacts__icon"><Icon name="mail" size={22} /></span>
      <div>
        <p class="contacts__label">Email</p>
        <a href={`mailto:${c.email}`}>{c.email}</a>
      </div>
    </li>
    <li>
      <span class="contacts__icon"><Icon name="pin" size={22} /></span>
      <div>
        <p class="contacts__label">Производство</p>
        <address>{c.address}</address>
        <a class="link-underline contacts__route" href={c.routeUrl} target="_blank" rel="noopener noreferrer">Построить маршрут</a>
      </div>
    </li>
    <li>
      <span class="contacts__icon"><Icon name="truck" size={22} /></span>
      <div>
        <p class="contacts__label">Доставка</p>
        <p>По всей России транспортными компаниями</p>
      </div>
    </li>
  </ul>
</div>

<style>
  .contacts { display: grid; gap: var(--space-7); align-items: center; }
  .contacts__lead h2 { font-size: var(--text-3xl); max-width: 16ch; }
  .contacts__phone { display: inline-block; padding-block: 0.3rem; margin-top: var(--space-4); font-family: var(--font-serif); font-size: clamp(2rem, 1.2rem + 4vw, 3.5rem); line-height: 1.1; color: var(--color-text-strong); text-decoration: none; white-space: nowrap; user-select: text; }
  .contacts__phone:hover { color: var(--color-brand-hover); }
  .contacts__hint { margin-block: var(--space-3) var(--space-5); color: var(--color-text-muted); }
  .contacts__list { display: grid; gap: var(--space-3); }
  .contacts__list li { display: flex; gap: var(--space-4); padding: var(--space-5); background: var(--card-bg); border: var(--border-thin) solid var(--card-border); border-radius: var(--card-radius); }
  .contacts__icon { display: inline-grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border: var(--border-thin) solid var(--color-border-strong); border-radius: var(--radius-round); color: var(--color-brand); }
  .contacts__label { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--color-text-muted); margin-bottom: var(--space-1); }
  .contacts address { font-style: normal; }
  .contacts__list a:not(.link-underline) { display: inline-block; padding-block: 0.6rem; color: var(--color-text-strong); text-decoration: none; word-break: break-word; }
  .contacts__list a:not(.link-underline):hover { text-decoration: underline; }
  .contacts__route { margin-top: 0; font-size: var(--text-sm); color: var(--color-brand); }
  @media (min-width: 900px) {
    .contacts { grid-template-columns: 1.1fr 1fr; gap: var(--space-8); }
  }
</style>
