---
import Picture from '../Picture.astro';
import { site, url } from '../../lib/site.js';
---
<div class="hero-stage" data-hero-stage>
  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="hero__media">
      <Picture
        class="hero__img"
        id="hero/hero"
        alt="Гостиная с угловым диваном тёмно-зелёного цвета"
        sizes="(max-width: 899px) 170vh, 100vw"
        priority
        fallbackWidth={960}
      />
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__dim" aria-hidden="true"></div>
    <div class="container hero__content">
      <div class="hero__text">
        <h1 id="hero-title"><span>{site.brand.slogan.split(', ')[0]},</span> <span>{site.brand.slogan.split(', ').slice(1).join(', ')}</span></h1>
        <p class="hero__lead">{site.brand.tagline}</p>
        <div class="hero__actions">
          <a class="btn btn--sand btn--lg" href={url('#catalog')}>Смотреть каталог</a>
          <a class="link-underline" href={url('#about')}>О фабрике</a>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  /* ---------- base hero (also the reduced-motion / no-JS version) ---------- */
  .hero { position: relative; isolation: isolate; display: grid; align-items: start; min-height: min(38rem, 92svh); background: var(--green-950); color: var(--color-on-dark); overflow: hidden; }
  .hero__media { position: absolute; inset: 0; z-index: -3; }
  .hero__media :global(picture), .hero__media :global(.hero__img) { display: block; width: 100%; height: 100%; }
  .hero__media :global(.hero__img) { object-fit: cover; object-position: 80% 50%; }
  .hero__shade { position: absolute; inset: 0; z-index: -2; background: linear-gradient(90deg, rgb(16 30 21 / 0.55) 0%, rgb(16 30 21 / 0.3) 60%, rgb(16 30 21 / 0.1) 100%), linear-gradient(180deg, rgb(16 30 21 / 0.2) 0%, rgb(16 30 21 / 0) 45%, rgb(16 30 21 / 0.55) 100%); }
  .hero__dim { position: absolute; inset: 0; z-index: -1; background: var(--green-950); opacity: 0; pointer-events: none; }
  .hero__content { padding-block: clamp(3.5rem, 13svh, 5.5rem) var(--space-7); }
  .hero h1 span { display: block; }
  .hero h1 { max-width: 20ch; font-size: clamp(2rem, 8.8vw, 3rem); color: var(--color-accent); }
  .hero__lead { max-width: 18rem; margin-top: var(--space-5); font-size: var(--text-base); color: var(--color-on-dark); }
  .hero__actions { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); margin-top: var(--space-6); }
  .hero .link-underline { color: var(--color-on-dark); }

  @media (min-width: 640px) {
    .hero h1 { font-size: var(--text-hero); }
    .hero__lead { max-width: 26rem; font-size: var(--text-lg); }
    .hero__actions { flex-direction: row; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); }
  }
  @media (min-width: 900px) {
    .hero { align-items: center; min-height: clamp(34rem, 46vw, 40rem); }
    .hero__shade { background: linear-gradient(90deg, rgb(16 30 21 / 0.82) 0%, rgb(16 30 21 / 0.5) 42%, rgb(16 30 21 / 0.08) 75%); }
    .hero__content { padding-block: var(--space-9); }
    .hero h1 { max-width: 20ch; }
    .hero__media :global(.hero__img) { object-position: 50% 50%; }
  }

  /* ---------- scroll effect ----------
     The hero is pinned (sticky). The photo zooms and darkens while it is pinned. The text stays fully visible
     until the next block (advantages) catches the hero (the pin ends) and starts moving up with it; only then it fades. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-stage {
      --hh: clamp(30rem, calc(100vh - var(--header-h)), 60rem);
      --hh: clamp(30rem, calc(100svh - var(--header-h)), 60rem); /* hero height while pinned */
      --sh: 103svh;                                             /* stage (scroll track) height */
      --pin-end: max(0px, calc(var(--sh) - var(--hh)));          /* scroll distance at which the hero stops being pinned */
      --fade: 12svh;                                            /* text fades over this distance after the pin ends */
      position: relative;
      height: var(--sh);
    }
    :global(.js) .hero { position: sticky; top: var(--header-h); height: var(--hh); z-index: 1; }
    :global(.js) .hero__media, :global(.js) .hero__text { will-change: transform, opacity; }
    /* the blocks after the hero sit above the pinned photo and cover it as they arrive */
    :global(.js) .hero-stage ~ :global(section) { position: relative; z-index: 2; }
    :global(.js) .hero-stage + :global(section) { margin-top: -16svh; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 900px) {
    :global(.js) .hero-stage {
      --hh: clamp(32rem, calc(100vh - var(--header-h-lg)), 60rem);
      --hh: clamp(32rem, calc(100svh - var(--header-h-lg)), 60rem);
      --sh: 104svh;
    }
    :global(.js) .hero { top: var(--header-h-lg); }
  }

  /* Browsers with scroll-driven animations: pure CSS */
  @keyframes hero-zoom { to { transform: scale(1.08); } }
  @keyframes hero-dim { to { opacity: 0.4; } }
  @keyframes hero-out { to { opacity: 0; transform: translateY(-9svh); } }
  @keyframes hero-fade { to { opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      :global(.js) .hero__media { animation: hero-zoom linear both; animation-timeline: scroll(root block); animation-range: 0 calc(var(--pin-end) + var(--fade)); }
      :global(.js) .hero__dim { animation: hero-dim linear both; animation-timeline: scroll(root block); animation-range: 0 calc(var(--pin-end) + var(--fade)); }
      :global(.js) .hero__text { animation: hero-out linear both; animation-timeline: scroll(root block); animation-range: var(--pin-end) calc(var(--pin-end) + var(--fade)); }
    }
    /* Fallback (no scroll-driven animations): a tiny script writes --p / --q (0..1) on the stage */
    @supports not (animation-timeline: scroll()) {
      :global(.js) .hero__media { transform: scale(calc(1 + 0.08 * var(--p, 0))); }
      :global(.js) .hero__dim { opacity: calc(0.4 * var(--p, 0)); }
      :global(.js) .hero__text { opacity: calc(1 - var(--q, 0)); transform: translateY(calc(var(--q, 0) * -9svh)); }
    }
  }
  /* Phones: lighter effect — no zoom, only fade */
  @media (prefers-reduced-motion: no-preference) and (max-width: 899px) {
    @supports (animation-timeline: scroll()) {
      :global(.js) .hero__media { animation: none; }
      :global(.js) .hero__dim { animation: none; }
      :global(.js) .hero__text { animation: hero-fade linear both; animation-timeline: scroll(root block); animation-range: var(--pin-end) calc(var(--pin-end) + var(--fade)); }
    }
    @supports not (animation-timeline: scroll()) {
      :global(.js) .hero__media { transform: none; }
      :global(.js) .hero__dim { opacity: 0; }
      :global(.js) .hero__text { transform: none; }
    }
  }
</style>
