---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../lib/site.js';
import interCyr from '../fonts/inter-cyrillic-wght-normal.woff2?url';
import interLat from '../fonts/inter-latin-wght-normal.woff2?url';
import loraCyr from '../fonts/lora-cyrillic-wght-normal.woff2?url';

const {
  title,
  description = site.seo.defaultDescription,
  image = 'img/og.jpg',
  path = Astro.url.pathname,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const ym = site.analytics.yandexMetrika; // disabled by default: enabling it requires a cookie notice + privacy policy
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(url(image), Astro.site).href;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#182A1E" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand.legalName} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" sizes="32x32" href={url('img/icon-32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={url('img/icon-192.png')} />
    <link rel="apple-touch-icon" href={url('img/apple-touch-icon.png')} />

    <link rel="preload" as="font" type="font/woff2" href={interCyr} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLat} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={loraCyr} crossorigin />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {ym.enabled && ym.id && (
      <script is:inline set:html={`(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');ym(${Number(ym.id)},'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true});`} />
    )}
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">К содержимому</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/ui.js';
    </script>
  </body>
</html>
